[36.380148, "o", "\r\n-- the PR guide's own version-resolution snippet, run live:\r\n\r\n$ sed -n '/## Option B/,/^ARCH/p' docs/install/ubuntu.md | head -10\r\n"]
[36.42946, "o", "## Option B — raw binary tarball\r\n\r\nNo package database entry; you manage the binary yourself.\r\n\r\n```bash\r\nVERSION=$(curl -fsSL https://api.github.com/repos/peasant-labs/peasant/releases/latest | sed -n 's/.*\"tag_name\": *\"v\\([^\"]*\\)\".*/\\1/p')   # latest release; pin one with e.g. VERSION=0.12.0\r\n: \"${VERSION:?could not read the latest release (GitHub API rate limit?); set VERSION=0.12.0 by hand}\"\r\nARCH=amd64    # or arm64\r\n\r\n$ VERSION=$(curl -fsSL https://api.github.com/repos/peasant-labs/peasant/releases/latest | sed -n 's/.*\"tag_name\": *\"v\\([^\"]*\\)\".*/\\1/p')\r\n"]
[37.839292, "o", "\r\n$ : \"${VERSION:?could not read the latest release (GitHub API rate limit?); set VERSION=0.12.0 by hand}\"\r\n\r\n$ ARCH=amd64; echo \"VERSION=$VERSION ARCH=$ARCH\"\r\nVERSION=0.13.4 ARCH=amd64\r\n"]
[37.839377, "o", "\r\n$ URL=\"https://github.com/peasant-labs/peasant/releases/download/v${VERSION}/peasant_${VERSION}_linux_${ARCH}.tar.gz\"; echo $URL\r\nhttps://github.com/peasant-labs/peasant/releases/download/v0.13.4/peasant_0.13.4_linux_amd64.tar.gz\r\n\r\n$ curl -sIL -o /dev/null -w 'tar.gz: HTTP %{http_code}\\n' \"$URL\"\r\n"]
[40.477236, "o", "tar.gz: HTTP 200\r\n"]
[40.618963, "o", "\r\n$ curl -sIL -o /dev/null -w '.deb:   HTTP %{http_code}\\n' \"https://github.com/peasant-labs/peasant/releases/download/v${VERSION}/peasant_${VERSION}_linux_${ARCH}.deb\"\r\n"]
[43.269712, "o", ".deb:   HTTP 200\r\n"]
[43.416029, "o", "\r\n$ gh release view --repo peasant-labs/peasant --json assets --jq '.assets[].name' | grep linux_amd64\r\n"]
[46.729421, "o", "peasant_0.13.4_linux_amd64.deb\r\npeasant_0.13.4_linux_amd64.rpm\r\npeasant_0.13.4_linux_amd64.tar.gz\r\n"]
[46.73402, "o", ">> Constructed asset names match the real release assets exactly.\r\n"]
[49.777174, "o", "\r\n-- guard behaviour when the lookup returns no version (rate-limit payload):\r\n\r\n$ ( VERSION=$(printf '%s' '{\"message\":\"API rate limit exceeded\"}' | sed -n 's/.*\"tag_name\": *\"v\\([^\"]*\\)\".*/\\1/p'); : \"${VERSION:?could not read the latest release (GitHub API rate limit?); set VERSION=0.12.0 by hand}\" )\r\n"]
[49.902579, "o", "/home/hatch/workspace/pr-evidence/pr-733-media/demo.sh: line 5: VERSION: could not read the latest release (GitHub API rate limit?); set VERSION=0.12.0 by hand\r\n"]
[49.921962, "o", ">> Guard exit code: 1 - clear message, no broken download URL is built.\r\n"]
[52.966576, "o", "\r\n================================================================\r\n BEFORE: guide pins VERSION=0.1.0 (stale; Windows asset 404)\r\n AFTER:  guide resolves the latest release live (shown above)\r\n         and HEAD-checks 200; failure is guarded with a message.\r\n================================================================\r\n"]
