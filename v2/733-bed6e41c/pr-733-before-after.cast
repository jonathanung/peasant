[0.108215, "o", "\u001b[H\u001b[2J\u001b[3J================================================================\r\n PR #733 - docs(install): fetch the latest release instead\r\n of pinning 0.1.0   (issue #694)\r\n Proof = execute each guide's own commands, live.\r\n================================================================\r\n"]
[3.153783, "o", "\r\n########## BEFORE - base branch: develop ##########\r\n\r\n$ git checkout -q develop && git log --oneline -1\r\n"]
[4.395693, "o", "\u001b[33mbe2bc57f\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD\u001b[m\u001b[33m -> \u001b[m\u001b[1;32mdevelop\u001b[m\u001b[33m, \u001b[m\u001b[1;33mtag: \u001b[m\u001b[1;33mv0.13.4\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/develop\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m release(v0.13.4): restore canonical transcript host and recorded PR evidence (#774)\r\n"]
