{"version": 2, "width": 120, "height": 36, "timestamp": 1793213199, "env": {"SHELL": null, "TERM": null}, "title": "PR #718 before/after - unknown /api/ paths JSON 404"}
[0.121581, "o", "================================================================\r\nPR #718 — fix(api): answer unknown /api/ paths with a JSON 404\r\nIssue #699 item 1: curl /api/v1/does-not-exist returned the SPA\r\ndashboard page with 200 text/html on develop.\r\n================================================================\r\n\r\n##### BEFORE — develop be2bc57f (current develop tip) #####\r\n$ peasant-before web start --port 18718   (throwaway HOME)\r\n"]
[3.755689, "o", "\r\n"]
[3.76728, "o", "$ curl -i http://localhost:18718/api/v1/does-not-exist\r\n"]
[3.975257, "o", "HTTP/1.1 200 OK\r\r\nContent-Type: text/html\r\r\nDate: Wed, 28 Oct 2026 18:46:43 GMT\r\r\nTransfer-Encoding: chunked\r\r\n\r\r\n<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<meta name=\"color-scheme\" content=\"dark light\">\r\n<title>local app not bundled | peasant</title>\r\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Atkinson+Hyperlegible+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap\" rel=\"stylesheet\">\r\n<style>:root{color-scheme:dark;--canvas:#0b0b0a;--surface:#0b0b0a;--surface-2:#1c1b18;--ink-strong:#fbf8f1;--ink:#ece8df;--ink-2:#cdc8bb;--ink-3:#b3ad9f;--rule:#4f4a40;--rule-strong:#857f72;--amber:#d6ae66;--warning:#d6ae66;--success:#a9b688;--danger:#d08f74;--focus-ring:#d6ae66}\r\n@media (prefers-color-scheme:light){:root{color-scheme:light;--canvas:#fbfaf7;--surface:#fbfaf7;--surface-2:#f1eee6;--ink-strong:#0d0c09;--ink:#1f1c17;--ink-2:#3d3932;--ink-3:#4f4a41;--rule:#b3ab96;--rule-strong:#7f7762;--amber:#8a5f1f;--warning:#8a5f1f;--success:#586a3c;--danger:#974b32;--focus-ring:#0d0c09}}\r\n*,*::before,*::after{box-sizing:border-box}\r\nhtml{-webkit-text-size-adjust:100%;text-size-adjust:100%}\r\nbody{margin:0;min-height:100vh;min-height:100dvh;display:grid;place-items:center;padding:32px 16px;background:var(--canvas);color:var(--ink);font-family:\"Atkinson Hyperlegible\",ui-sans-serif,system-ui,-apple-system,sans-serif;font-size:16px;line-height:1.5;letter-spacing:.03em;word-spacing:.16em;-webkit-font-smoothing:antialiased}\r\n::selection{background:var(--amber);color:var(--canvas)}\r\n.pg-card{width:min(27.5rem,100%);border:1px solid var(--rule-strong);background:var(--surface)}\r\n.pg-card>header,.pg-card>footer{padding:20px 24px}\r\n.pg-card>header{display:grid;gap:16px;border-bottom:1px solid var(--rule)}\r\n.pg-card>footer{border-top:1px solid var(--rule)}\r\n.pg-brand,."]
[3.976722, "o", "pg-card h1,.pg-status,.pg-note,.pg-hint,.pg-value,.pg-card code{font-family:\"Atkinson Hyperlegible Mono\",ui-monospace,Menlo,Consolas,monospace;letter-spacing:0;word-spacing:0}\r\n.pg-brand{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:16px;color:var(--ink-strong)}\r\n.pg-brand svg{flex:none;width:18px;height:22px;color:var(--amber)}\r\n.pg-card h1{margin:0;font-weight:700;font-size:22px;line-height:1.2;color:var(--ink-strong)}\r\n.pg-body{display:grid;gap:20px;padding:24px}\r\n"]
[3.994986, "o", "\r\n$ curl -s -o /dev/null -w '%{http_code} %{content_type}\\n' http://localhost:18718/api/v1/does-not-exist\r\n"]
[4.125118, "o", "200 text/html\r\n"]
[6.369708, "o", "\r\n##### AFTER — PR #718 head, rebased onto develop (7f789c2a) #####\r\n$ peasant-after web start --port 18718   (throwaway HOME)\r\n"]
[11.433283, "o", "\r\n$ curl -i http://localhost:18718/api/v1/does-not-exist\r\n"]
[11.562392, "o", "HTTP/1.1 404 Not Found\r\r\nContent-Type: application/json\r\r\nDate: Wed, 28 Oct 2026 18:46:50 GMT\r\r\nContent-Length: 122\r\r\n\r\r\n{\"error\":\"no API route serves GET /api/v1/does-not-exist; check the path against the routes this server version exposes\"}\r\n"]
[11.573412, "o", "\r\n$ curl -s -o /dev/null -w '%{http_code} %{content_type}\\n' http://localhost:18718/api/v1/does-not-exist\r\n"]
[11.668709, "o", "404 application/json\r\n"]
[11.783732, "o", "\r\n--- a real endpoint still works ---\r\n$ curl -i http://localhost:18718/api/v1/settings   (body truncated to 500 chars)\r\n"]
[12.028169, "o", "HTTP/1.1 200 OK\r\r\nContent-Type: application/json\r\r\nDate: Wed, 28 Oct 2026 18:46:51 GMT\r\r\nTransfer-Encoding: chunked\r\r\n\r\r\n{\"settings\":[{\"key\":\"version\",\"kind\":\"integer\",\"value\":null,\"effective\":1,\"editable\":false,\"inPeasantConfig\":false,\"description\":\"the configuration format version; peasant sets it\"},{\"key\":\"user.email\",\"kind\":\"string\",\"value\":null,\"effective\":\"\",\"editable\":true,\"inPeasantConfig\":false},{\"key\":\"redaction.level\",\"kind\":\"choice\",\"value\":null,\"effective\":\"standard\",\"options\":[\"standard"]
[12.044614, "o", " ...[truncated]\r\n\r\n--- wrong method on a real route -> 405 + Allow ---\r\n$ curl -i -X GET http://localhost:18718/api/v1/shutdown\r\n"]
[12.179094, "o", "HTTP/1.1 405 Method Not Allowed\r\r\n"]
[12.180085, "o", "Allow: POST\r\r\nContent-Type: application/json\r\r\nDate: Wed, 28 Oct 2026 18:46:51 GMT\r\r\nContent-Length: 64\r\r\n\r\r\n{\"error\":\"/api/v1/shutdown does not serve GET; it serves POST\"}\r\n"]
[12.197295, "o", "\r\n$ curl -i -X DELETE http://localhost:18718/api/v1/settings\r\n"]
[12.384299, "o", "HTTP/1.1 405 Method Not Allowed\r\r\nAllow: GET, PATCH\r\r\nContent-Type: application/json\r\r\nDate: Wed, 28 Oct 2026 18:46:51 GMT\r\r\nContent-Length: 73\r\r\n\r\r\n{\"error\":\"/api/v1/settings does not serve DELETE; it serves GET, PATCH\"}\r\n"]
[12.384621, "o", "\r\n"]
[12.38768, "o", "--- bare /api still serves the dashboard (no redirect) ---\r\n$ curl -s -o /dev/null -w '%{http_code} %{content_type}\\n' http://localhost:18718/api\r\n"]
[12.421032, "o", "200 text/html\r\n"]
[12.42957, "o", "\r\n--- a non-API path still serves the dashboard ---\r\n$ curl -s -o /dev/null -w '%{http_code} %{content_type}\\n' http://localhost:18718/sessions/abc\r\n"]
[12.462917, "o", "200 text/html\r\n"]
[14.060966, "o", "\r\n"]
