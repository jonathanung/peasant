[0.199696, "o", "==============================================================\r\nBEFORE  (develop be2bc57f, unpatched)\r\n==============================================================\r\n\r\n$ setsid peasant kickstart </dev/null\r\n"]
[1.693156, "o", "Error: setup flow failed: bubbletea: error opening TTY: bubbletea: could not open TTY: open /dev/tty: no such device or address\r\n"]
[1.695948, "o", "Usage:\r\n  peasant kickstart [flags]\r\n\r\nAliases:\r\n  kickstart, ftue\r\n\r\nFlags:\r\n  -h, --help    help for kickstart\r\n      --reset   Remove config, credentials, database, ingested data, and state (full reset)\r\n\r\nGlobal Flags:\r\n      --config string       Path to config file (default: ~/.config/peasant/config.yaml) (default \"/tmp/tmp.L1dDH8NHdm/.config/peasant/config.yaml\")\r\n      --config-dir string   Override the config directory (default: $XDG_CONFIG_HOME or ~/.config); config lives under <config-dir>/peasant\r\n      --data-dir string     Override the data directory (default: $XDG_DATA_HOME or ~/.local/share); the DB + peasant-sync live under <data-dir>/peasant\r\n      --state-dir string    Override the state directory (default: $XDG_STATE_HOME or ~/.local/state); logs/PID live under <state-dir>/peasant\r\n  -v, --version             Print the version\r\n\r\n"]
[1.724988, "o", "[exit=1]\r\n"]
[2.738462, "o", "\r\n"]
[2.740112, "o", "$ setsid peasant config </dev/null\r\n"]
[3.737258, "o", "Error: run config editor for \"/tmp/tmp.L1dDH8NHdm/.config/peasant/config.yaml\": bubbletea: error opening TTY: bubbletea: could not open TTY: open /dev/tty: no such device or address.\r\nwhat: the interactive terminal session stopped unexpectedly.\r\nwhy: Bubble Tea could not complete the mounted Screen session.\r\nwhere: peasant config terminal runner.\r\nwhen: while editing buffered settings.\r\nmeans: only a save confirmed before this terminal error could have changed a file.\r\nfix: inspect both named files, repair the terminal error, and retry peasant config.\r\nUsage:\r\n  peasant config [flags]\r\n\r\nAliases:\r\n  config, settings\r\n\r\nFlags:\r\n  -h, --help   help for config\r\n\r\nGlobal Flags:\r\n      --config string       Path to config file (default: ~/.config/peasant/config.yaml) (default \"/tmp/tmp.L1dDH8NHdm/.config/peasant/config.yaml\")\r\n      --config-dir string   Override the config directory (default: $XDG_CONFIG_HOME or ~/.config); config lives under <config-dir>/peasant\r\n      --data-dir string     Override the data directory (default: $XDG_DATA_HOME or ~/.local/share); the DB + peasant-sync live under <data-dir>/peasant\r\n"]
[3.75052, "o", "[exit=1]\r\n"]
